{
  "name": "music-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade Discord Music Bot with Canvas UI (TypeScript + discord.js + Lavalink 4)",
  "author": "thanhtinz",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview:canvas": "tsx scripts/preview-canvas.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.61",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
