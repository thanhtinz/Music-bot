{
  "name": "music-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade Discord Music Bot with Canvas UI (TypeScript + discord.js + Lavalink 4)",
  "author": "thanhtinz",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/src/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview:canvas": "tsx scripts/preview-canvas.ts",
    "preview:replies": "tsx scripts/preview-replies.ts",
    "sync:icons": "tsx scripts/sync-icons.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.61",
    "discord.js": "^14.27.0",
    "pino": "^9.5.0",
    "shoukaku": "^4.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.9.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "lucide-static": "^1.33.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.1.5"
  }
}
