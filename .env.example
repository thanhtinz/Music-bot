# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── Discord ────────────────────────────────────────────────────────────────
# From https://discord.com/developers/applications → your app → Bot → Token.
# Enable the "Message Content" privileged intent there too, or prefix commands
# will never reach the bot.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Register slash commands instantly in one guild while developing.
# Leave empty to register them globally (can take up to an hour to appear).
DISCORD_DEV_GUILD_ID=

# ── Guild defaults ─────────────────────────────────────────────────────────
DEFAULT_PREFIX=!
DEFAULT_VOLUME=70
MAX_QUEUE_SIZE=100

# ── Permissions ────────────────────────────────────────────────────────────
# Comma-separated Discord user ids with global control.
BOT_OWNER_IDS=
# Small servers usually want everyone to be a DJ; set false and fill DJ_ROLE_ID
# to restrict skip/stop/volume/filters to a role.
EVERYONE_IS_DJ=true
DJ_ROLE_ID=

# ── Lavalink ───────────────────────────────────────────────────────────────
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false
LAVALINK_NAME=main

# Extra nodes, so one dying does not stop the music.
# name@host:port:password per node, comma separated; add :secure for TLS.
# LAVALINK_NODES=backup@10.0.0.5:2333:youshallnotpass,eu@lava.example.com:443:pw:secure
LAVALINK_NODES=

# ── Canvas UI ──────────────────────────────────────────────────────────────
# sakura = the illustrated pastel templates, classic = themeable dark panels.
CARD_VARIANT=sakura
# Theme for the classic variant: midnight | sunset | forest | sakura
CANVAS_THEME=midnight
# webp = the same picture at a seventeenth of the size (947 KB -> 56 KB) and a
# quarter of the encode time. png is here to fall back to.
CARD_FORMAT=webp
# WebP quality. 90 is indistinguishable from the PNG at 2x zoom.
CARD_QUALITY=90

# Spotify, Apple Music and Deezer live in the audio node, not the bot: these
# are passed through to Lavalink's LavaSrc plugin by docker compose. Leave any
# of them blank and that service's links are unsupported — everything else
# works, and the bot says which service is off rather than "unavailable".
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# A media-api token from the Apple Music web player.
APPLE_MUSIC_TOKEN=
# Deezer's tracks are encrypted; LavaSrc needs the key to read them.
DEEZER_DECRYPTION_KEY=

# ── Storage ────────────────────────────────────────────────────────────────
# Set this and playlists, settings, stats and sessions all move to Postgres and
# the four paths below are ignored. Leave it blank and they stay JSON files,
# which is the right default for a single bot on one machine.
# `docker compose --profile postgres up -d` starts one:
# DATABASE_URL=postgresql://musicbot:musicbot@127.0.0.1:5432/musicbot
DATABASE_URL=
# Credentials for that compose service, if you use it.
POSTGRES_USER=musicbot
POSTGRES_PASSWORD=musicbot
POSTGRES_DB=musicbot

# Where saved playlists are written. Mount this path to keep them across
# deploys; blank it to keep playlists in memory and lose them on restart.
PLAYLIST_STORE_PATH=data/playlists.json

# Where per-guild settings are written; blank keeps them in memory.
SETTINGS_STORE_PATH=data/settings.json

# Where live sessions are written so a restart picks the queue back up.
# Blank keeps them in memory, which means a restart loses the queue.
SESSION_STORE_PATH=data/sessions.json
# Sessions older than this are dropped rather than resumed (15 minutes).
SESSION_MAX_AGE_MS=900000

# Where listening stats are written, for /stats. Blank keeps them in memory,
# which means the counts start over on every restart.
STATS_STORE_PATH=data/stats.json

# ── Public website ─────────────────────────────────────────────────────────
# The site people land on: a home page, a command list and a status page with
# a per-shard breakdown. 0 turns it off, which is the default — a bot nobody
# is inviting does not need one.
# Deliberately a different port from METRICS_PORT below: this one binds every
# interface and serves counts, that one binds loopback and serves guild names
# and track titles. Never put a proxy in front of the metrics port.
PUBLIC_PORT=0
PUBLIC_HOST=0.0.0.0
# Linked in the footer when set.
PUBLIC_SOURCE_URL=
PUBLIC_SUPPORT_URL=

# ── Sharding ───────────────────────────────────────────────────────────────
# Only read by `npm run start:sharded`, which spawns one process per shard.
# `auto` asks Discord how many the bot needs. Sharding requires DATABASE_URL:
# several processes writing the same JSON files would overwrite each other.
# `npm start` ignores this and runs one process.
SHARD_COUNT=auto

# Port for /healthz, /readyz and /metrics. 0 turns the endpoint off.
# Each shard listens on this port plus its own id, so shard 3 of a bot on
# 9100 is on 9103.
METRICS_PORT=0
# Bind address for it; loopback keeps it off the public internet.
METRICS_HOST=127.0.0.1
# How long an idle player waits before leaving, unless a guild turns on 24/7.
IDLE_TIMEOUT_MS=300000
