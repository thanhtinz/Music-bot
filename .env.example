# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── Discord ────────────────────────────────────────────────────────────────
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Register slash commands instantly in one guild while developing.
# Leave empty to register them globally.
DISCORD_DEV_GUILD_ID=

# ── Guild defaults ─────────────────────────────────────────────────────────
DEFAULT_PREFIX=!
DEFAULT_VOLUME=70
MAX_QUEUE_SIZE=100

# ── Canvas UI ──────────────────────────────────────────────────────────────
# midnight | sunset | forest
CANVAS_THEME=midnight
